# Для работы авторизации (вход, регистрация, профиль) нужны ключи Supabase.
# Скопируйте этот файл в .env.local и подставьте свои значения.
# В Supabase: Dashboard → Settings → API → Project URL и anon public key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role (secret!) — нужен для серверных ходов / resign / draw / timeout / рейтинга.
# Dashboard → Settings → API → service_role (secret). НЕ публикуйте в клиент и git.
# Добавьте также в Vercel → Project → Settings → Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: distributed rate limits via Supabase RPC (needs Phase G migration)
# USE_DB_RATE_LIMIT=1
# REQUIRE_SERVICE_ROLE=1

# Базовый URL сайта для SEO (robots.txt, sitemap.xml). Пример: https://ais-chess.example.com
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
